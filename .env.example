# Tugra - ornek ortam degiskenleri.
# Bu dosya commit edilir ve ASLA gercek deger icermez.
# Gercek degerler yalnizca .gitignore'daki .env dosyasinda tutulur.

# Monad testnet RPC. Resmi dokumandan dogrulandi (chain id 10143):
#   https://testnet-rpc.monad.xyz        (QuickNode, 50 rps)
#   https://rpc.ankr.com/monad_testnet   (Ankr)
#   https://rpc-testnet.monadinfra.com   (Monad Foundation, 20 rps)
MONAD_RPC_URL=

# Kasanin sahibi olan cuzdanin ozel anahtari
OWNER_PRIVATE_KEY=

# Ajan cuzdaninin ozel anahtari (yalnizca islem gas'i tutar)
AGENT_PRIVATE_KEY=

# Anthropic API anahtari
ANTHROPIC_API_KEY=

# Deploy sonrasi doldurulur
VAULT_ADDRESS=

# Guvenilir kayitli alici (saglayici). Ekranda isimle gosterilir.
PROVIDER_ADDRESS=

# Operator kontrolundeki ayri adres. Ekranda "Bilinmeyen adres" olarak gorunur.
ATTACKER_ADDRESS=

# Kanit akisinda 3. adimdan sonra doldurulur
MANDATE_ID=

# script/make-wallets.sh tarafindan doldurulur (adresler kolaylik icin saklanir)
OWNER_ADDRESS=
AGENT_ADDRESS=
