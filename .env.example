# Tugra - ornek ortam degiskenleri.
# Bu dosya commit edilir ve ASLA gercek deger icermez.
# Gercek degerler yalnizca .gitignore'daki .env dosyasinda tutulur.

# Monad testnet RPC adresi (resmi Monad dokumanindan alinacak)
MONAD_RPC_URL=

# Kasanin sahibi olan cuzdanin ozel anahtari
OWNER_PRIVATE_KEY=

# Ajan cuzdaninin ozel anahtari (yalnizca islem gas'i tutar)
AGENT_PRIVATE_KEY=

# Anthropic API anahtari
ANTHROPIC_API_KEY=

# Deploy sonrasi doldurulur
VAULT_ADDRESS=
